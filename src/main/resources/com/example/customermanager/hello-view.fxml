<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT"
      spacing="10.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.customermanager.HelloController">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <!-- Title -->
    <Label text="CUSTOMER MANAGER"/>

    <!-- Name -->
    <Label text="Name:"/>

    <TextField fx:id="nameField"
               promptText="Enter customer name"/>

    <!-- Province -->
    <Label text="Province:"/>

    <ComboBox fx:id="provinceBox"
              promptText="Select Province"/>

    <!-- Add Customer -->
    <Button text="_Add Customer"
            mnemonicParsing="true"
            onAction="#addCustomer"/>

    <!-- Delete Customer -->
    <Button text="_Delete Customer"
            mnemonicParsing="true"
            onAction="#deleteCustomer"/>

    <!-- Customer Table -->
    <TableView fx:id="customerTable"
               prefHeight="250.0">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="200.0"/>

            <TableColumn fx:id="provinceColumn"
                         text="Province"
                         prefWidth="200.0"/>

        </columns>

    </TableView>

</VBox>